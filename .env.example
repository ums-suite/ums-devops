# Copy this file to .env (gitignored, same directory) - docker-compose.yml's postgres/minio
# containers read their bootstrap credentials from these vars instead of having them written
# directly into docker-compose.yml (which is committed to git).
#
# scripts/dev-up.sh copies this file to .env automatically on first run if it's missing, so the
# defaults below are safe to keep as-is for local dev - these are throwaway containers only
# reachable from your own machine, not real secrets (ums-conventions.md Resilience & Reliability:
# "Local development reads from a gitignored .env ... the cluster reads from Kubernetes Secrets").
# Change them only if you want non-default local values.

POSTGRES_USER=ums
POSTGRES_PASSWORD=ums_dev_password
POSTGRES_DB=ums

MINIO_ROOT_USER=ums_minio
MINIO_ROOT_PASSWORD=ums_minio_password
MINIO_BUCKET=ums-documents
