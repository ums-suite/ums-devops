# Single source of truth for every host port this platform's local-dev tooling uses. Not a secret
# (unlike .env, which holds generated/throwaway credentials) - safe to commit, loaded via
# `docker compose --env-file ports.env ...` (scripts/dev-up.sh/dev-down.sh/dev-logs.sh already do
# this) rather than named `.env`, so it isn't caught by the blanket `.env`/`.env.*` gitignore rule.
#
# Change a port ONLY here, then propagate to any non-Docker consumer (ums-core's own
# appsettings.Development.json, a frontend's proxy.conf.json, etc.) once those repos exist - see
# README.md's Ports table for the full list of what to touch.

# --- Shared infra (docker-compose.yml) ---
POSTGRES_PORT=5433   # 5432 is commonly already taken by a local Postgres install
REDIS_PORT=6380      # 6379 is commonly already taken by a local Redis install
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Observability (docker-compose.observability.yml) ---
GRAFANA_PORT=3000
LOKI_PORT=3100
TEMPO_PORT=3200
PROMETHEUS_PORT=9090
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_METRICS_PORT=8889
OTEL_HEALTH_PORT=13133

# --- Reserved for when each repo reaches a deployable state (release/DEVELOPMENT_PLAN.md) ---
# Not used by any docker-compose.yml service yet - listed here so the eventual port choice is
# decided once, in one place, rather than improvised per-repo later. ums-core is ONE deployable
# (ADR-0001) with no gateway (container-diagram.md), so it gets exactly one port; UMS.Workers
# exposes only its /health/live + /health/ready endpoints (ums-conventions.md Observability), no
# public traffic.
UMS_CORE_PORT=8080          # ums-core (single ASP.NET Core Web API, all 18 modules)
UMS_WORKERS_PORT=8081       # UMS.Workers (health endpoints only - ADR-0014)
PUBLIC_WEB_PORT=4200        # ums-public-web
ADMISSION_WEB_PORT=4201     # ums-admission-web
STUDENT_WEB_PORT=4202       # ums-student-web
FACULTY_WEB_PORT=4203       # ums-faculty-web
ADMIN_WEB_PORT=4204         # ums-admin-web
ALUMNI_WEB_PORT=4205        # ums-alumni-web
